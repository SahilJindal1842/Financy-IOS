# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# Authentication Security (Generate a 64+ char random hex string for production)
JWT_SECRET=your-production-jwt-secret-key-change-this

# CORS Configuration (Comma-separated allowed web dashboard domains)
CORS_ORIGIN=https://admin.yourdomain.com,http://localhost:3001

# Email / SMTP Configuration (e.g. Gmail App Password, Resend, SendGrid, Amazon SES)
GMAIL_USER=
GMAIL_APP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Financy <no-reply@financy.app>

# Supabase Auth Configuration (for Email OTP without custom SMTP)
SUPABASE_URL=https://ktwlxmhavcvihlwvnnmg.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Social Authentication Credentials
APPLE_BUNDLE_ID=com.financy.in
GOOGLE_CLIENT_ID=427668842020-your-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
